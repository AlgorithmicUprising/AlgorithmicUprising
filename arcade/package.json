{
  "name": "punk-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "npx tsc --noEmit && npm run build && npm run validate && node tools/check-size.mjs && node tools/check-hygiene.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate-skin.mjs && node tools/validate-cookie-wall-art.mjs",
    "dev": "node tools/serve.mjs",
    "e2e": "playwright test",
    "stage-pages": "node tools/stage-pages.mjs",
    "prepare-tag-art": "node tools/prepare-tag-art.mjs",
    "template": "node tools/template-cookie-wall-art.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "@playwright/test": "^1.56.1",
    "sharp": "^0.34.5"
  }
}
